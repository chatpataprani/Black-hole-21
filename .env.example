# Port the server listens on. Most free hosts (Replit, Render, etc.)
# inject their own PORT value automatically - you usually don't need
# to set this yourself.
PORT=3000

# How long (ms) a disconnected player's game stays alive waiting for
# them to reconnect before the room is torn down.
RECONNECT_TIMEOUT_MS=120000

# How long (ms) an inactive/finished room is kept in memory before
# being garbage collected.
ROOM_TTL_MS=1800000

# ============================================================
# Admin broadcast panel (public/admin.html) — OPTIONAL
# ============================================================

# A long random string only you know. Required for /admin.html and the
# /api/admin/* routes to work at all — without it, those routes return
# 503 rather than falling back to any default. Generate one with e.g.
# `openssl rand -hex 32`.
ADMIN_TOKEN=

# ============================================================
# Firebase Cloud Messaging (push notifications) — OPTIONAL
# ============================================================
# See server/pushService.js for the full setup checklist. In short:
#   1. Create a Firebase project + Android app (com.blackhole21.game).
#   2. Download the service account JSON (Project Settings > Service
#      Accounts > Generate new private key).
#   3. Paste its full contents below as a single-line JSON string.
#   4. Run `npm install firebase-admin` on the server.
# Broadcasts are refused (not faked) until this is set.
FIREBASE_SERVICE_ACCOUNT=

